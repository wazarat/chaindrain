# ===== MVP web app (apps/mvp) =====
# Public anon key — safe to embed client-side. Reads chaindrain.* via Drizzle on the server.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — service-role bypasses RLS. Keep out of any NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Drizzle / postgres pooler. Use the SESSION pooler (port 5432) for introspect,
# the TRANSACTION pooler (port 6543) for runtime queries.
DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL_SESSION=postgresql://postgres.YOUR_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# ===== Phase 3 — DETECT leg pollers =====
ETHERSCAN_API_KEY=YourEtherscanFreeKey  # 5 req/s — get one at https://etherscan.io/apis
CRON_SECRET=change-me-long-random       # Vercel Cron Authorization: Bearer <CRON_SECRET>

# ===== Phase 5 — Daily digest =====
RESEND_API_KEY=re_...                   # https://resend.com (100/day free)
DIGEST_RECIPIENTS=ops@example.com,you@example.com
