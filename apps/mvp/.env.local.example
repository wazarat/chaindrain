NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

SUPABASE_SERVICE_ROLE_KEY=eyJ...

DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL_SESSION=postgresql://postgres.YOUR_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Phase 3 — DETECT leg
# Generate via: openssl rand -hex 32
# Vercel Cron sends this in Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=

# Free Etherscan API key (5 req/s tier) — required for admin-tx poller.
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Optional: override the default https://eth.llamarpc.com endpoint used by
# oracle-deviation (Chainlink reads) and bridge-pause (LayerZero paused() call).
# ETH_RPC_URL=https://your-private-rpc

# Phase 5 — daily digest (Resend)
# Daily 09:00 UTC cron at /api/cron/digest sends the last-24h alert summary to
# DIGEST_RECIPIENTS using RESEND_API_KEY. Free tier is 100 emails/day.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Comma-separated list of recipient addresses.
DIGEST_RECIPIENTS=
# Optional override for the From: header. Defaults to "Chaindrain Alerts <onboarding@resend.dev>"
# (Resend's no-DNS-required test sender). Switch to alerts@chaindrain.xyz once
# the domain is verified in the Resend dashboard.
# RESEND_FROM=Chaindrain Alerts <alerts@chaindrain.xyz>
# Optional override for links inside the email. Defaults to https://www.chaindrain.xyz
# NEXT_PUBLIC_APP_BASE_URL=https://www.chaindrain.xyz
